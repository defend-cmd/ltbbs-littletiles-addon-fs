{
	"schemaVersion": 1,
	"id": "ltbbs",
	"version": "${version}",
	"name": "LittleTiles BBS FS Addon",
	"description": "A LittleTiles structure catalog and BBS Block Form integration for BBS FS 2.6.",
	"authors": [
		"larisa"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.larisa.ltbbs.LTBBS"
		],
		"client": [
			"com.larisa.ltbbs.LTBBSClient"
		]
	},
	"mixins": [
		"ltbbs.mixins.json",
		{
			"config": "ltbbs.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "=1.20.1",
		"java": ">=17",
		"bbs": "*"
	}
}
